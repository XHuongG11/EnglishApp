<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Màu nền -->
    <solid android:color="#FFFFFF"/>

    <!-- Viền ngoài -->
    <stroke
        android:width="2dp"
        android:color="#CCCCCC" /> <!-- Màu xám nhạt, bạn có thể đổi sang đen (#000000) hoặc xanh -->

    <!-- Bo góc -->
    <corners android:radius="20dp"/>

    <!-- Padding trong -->
    <padding
        android:left="15dp"
        android:top="10dp"
        android:right="10dp"
        android:bottom="10dp"/>
</shape>